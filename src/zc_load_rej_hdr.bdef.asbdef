projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_LOAD_REJ_HDR alias Header
{
  use create;
  use update;
  use delete;

  use action Fetch;
  use action FetchSerials;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Items { create; with draft; }
}

define behavior for ZC_LOAD_REJ_ITM alias Item
{
  use update;
  use delete;

  use action RejectAllItems;
  use action UnrejectAllItems;

  use association _Header { with draft; }
}